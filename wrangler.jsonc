{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "el-rinconcito-del-rock",
  "account_id": "8b0163597918b41cf5c6d61b87518515",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rinconcito-db",
      "database_id": "771694b2-2398-4bf8-b104-c4d9e1e400c1",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "STORE_NAME": "El Rinconcito del Rock",
    "INSTAGRAM_URL": "https://www.instagram.com/elrinconcitodelrock/",
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
}
