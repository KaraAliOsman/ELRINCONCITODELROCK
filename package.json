{
  "name": "el-rinconcito-del-rock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rinconcito-db --local",
    "db:migrate": "wrangler d1 migrations apply rinconcito-db --remote",
    "db:seed:local": "wrangler d1 execute rinconcito-db --local --file data/seed.sql",
    "db:seed": "wrangler d1 execute rinconcito-db --remote --file data/seed.sql",
    "test": "node scripts/test-store.mjs",
    "test:ci": "node scripts/ci-verify.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
